[Unit]
Description=TUNA network namespace execution broker
ConditionPathExists=/etc/tunasync/netns-policy.json
After=network.target
Before=tunasync-worker.service

[Service]
Type=simple
Group=tunasync
ExecStartPre=/usr/bin/tunasync-netns-broker --check --config /etc/tunasync/netns-policy.json --uid tunasync --gid tunasync
ExecStart=/usr/bin/tunasync-netns-broker --config /etc/tunasync/netns-policy.json --socket /run/tunasync/netns-broker.sock --socket-mode 0660 --uid tunasync --gid tunasync
Restart=on-failure
RestartSec=2
KillMode=control-group
RuntimeDirectory=tunasync
RuntimeDirectoryMode=0750
UMask=0077

# The broker needs CAP_SYS_ADMIN for setns and root only long enough to enter
# the namespace and drop to the configured worker identity before exec.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_CHOWN
AmbientCapabilities=
NoNewPrivileges=no
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadOnlyPaths=/run/netns /etc/tunasync/netns-policy.json
ReadWritePaths=/run/tunasync
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
