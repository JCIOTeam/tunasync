[Unit]
Description=TUNA mirrors sync worker
After=network.target

[Service]
Type=simple
User=tunasync
ExecStartPre=/usr/bin/tunasync worker --check -c /etc/tunasync/worker.conf --with-systemd
ExecStart=/usr/bin/tunasync worker -c /etc/tunasync/worker.conf --with-systemd
ExecReload=/bin/kill -SIGHUP $MAINPID
Restart=on-failure
RestartSec=5
RuntimeDirectory=tunasync
StateDirectory=tunasync
LogsDirectory=tunasync

# Hardening
ProtectSystem=strict
ReadWritePaths=/srv/mirrors
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
